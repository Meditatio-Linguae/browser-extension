{
    "manifest_version": 3,
    "name": "Anglysis",
    "description": "Analyze words. Unpack meanings. Uncover origins.",
    "version": "1.0.0",
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "http://localhost:3000/*"
    ],
    "background": {
        "service_worker": "background/background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "css": [
                "content/popup.css"
            ],
            "js": [
                "content/content.js"
            ]
        }
    ],
    "icons": {
        "16": "assets/icon16.png",
        "48": "assets/icon48.png",
        "128": "assets/icon128.png"
    }
}