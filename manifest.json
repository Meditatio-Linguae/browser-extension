{
    "manifest_version": 3,
    "name": "Etymon",
    "description": "Analyze words. Unpack meanings. Uncover origins.",
    "version": "1.1.0",
    "permissions": [
        "activeTab"
    ],
    "host_permissions": [
        "http://localhost:3000/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "css": [
                "popup.css"
            ],
            "js": [
                "content.js"
            ]
        }
    ],
    "web_accessible_resources": [
        {
        "resources": ["images/*"],
        "matches": ["<all_urls>"]
        }
    ],
    "action": {
        "default_title": "Etymon"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}